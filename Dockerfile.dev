# ============================================
# Development Dockerfile for Brahma Graha
# Supports live reload, hot module replacement, and debugging
# ============================================
FROM node:22-alpine

# Install libc6-compat, openssl, and ca-certificates for Prisma and cloud SSL connections
RUN apk add --no-cache libc6-compat openssl ca-certificates

WORKDIR /app

# Set development environment
ENV NODE_ENV=development
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Copy package definitions and prisma schema first for cached installation
COPY package.json package-lock.json* ./
COPY prisma ./prisma/

RUN npm install --legacy-peer-deps

# Copy entrypoint script
COPY docker-entrypoint.sh ./docker-entrypoint.sh
RUN chmod +x ./docker-entrypoint.sh

# Generate Prisma client
RUN npx prisma generate

EXPOSE 3000

ENTRYPOINT ["./docker-entrypoint.sh"]
CMD ["npm", "run", "dev"]
