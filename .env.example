# ============================================
# Brahma Graha - AI Consultation SaaS Platform
# Environment Variables
# ============================================

# --- Database ---
# Option A: Cloud Neon DB (Recommended)
DATABASE_URL="postgresql://neondb_owner:your_password@ep-your-subdomain.us-east-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=30&connection_limit=3"

# Option B: Local PostgreSQL
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brahma_graha?schema=public"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here-generate-with-openssl-rand-base64-32"

# --- OAuth Providers ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Email (SMTP) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@brahmagraha.com"

# --- AI Providers (Platform Default Keys) ---
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET=""

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Platform ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Brahma Graha"
# --- Security & Rate Limiting ---
# Generate with: openssl rand -hex 32 (produces a 64-character hex string = 32 bytes)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# Set to "true" to fail closed if Redis goes down for expensive AI operations (default: false = fallback to in-memory)
FAIL_CLOSED_ON_RATE_LIMIT_ERROR="false"
