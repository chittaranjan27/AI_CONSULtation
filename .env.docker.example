# ============================================
# Brahma Graha - Docker Environment Variables (Template)
# ============================================

# --- Database ---
# Default: Cloud Neon DB (Shared between local and Docker)
DATABASE_URL=postgresql://neondb_owner:your_password@ep-your-subdomain.us-east-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=30&connection_limit=3

# Alternative: Local Postgres container (only used when running with --profile local-db)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=brahma_graha
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/brahma_graha?schema=public

# --- Redis (Docker internal network) ---
REDIS_URL=redis://redis:6379

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=brahma-graha-docker-development-secret-key-32-chars-min

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Brahma Graha
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# --- AI Providers (Optional - Platform Defaults) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
SARVAM_API_KEY=

# --- Email (SMTP - Optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_PASSWORD=
SMTP_FROM=noreply@brahmagraha.com

# --- OAuth (Optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Stripe (Optional) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AWS S3 (Optional) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
